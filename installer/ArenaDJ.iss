#ifndef MyAppVersion
  #define MyAppVersion "2.0.5"
#endif

#define MyAppName "Aréna DJ"
#define MyAppPublisher "Aréna DJ"
#define MyAppExeName "MusiqueHockey.exe"

[Setup]
AppId={{A8E42D7C-1D64-4BD9-8C7B-28A62E47A6D2}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={localappdata}\Programs\Arena DJ
DefaultGroupName=Aréna DJ
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputDir=..\dist\installer
OutputBaseFilename=ArenaDJ-Setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\{#MyAppExeName}
SetupLogging=yes
CloseApplications=yes
RestartApplications=no
UsePreviousAppDir=yes
VersionInfoVersion={#MyAppVersion}
VersionInfoDescription=Aréna DJ — Console musicale
VersionInfoProductName=Aréna DJ
VersionInfoProductVersion={#MyAppVersion}

[Languages]
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Tasks]
Name: "desktopicon"; Description: "Créer un raccourci sur le Bureau"; GroupDescription: "Raccourcis :"

[Files]
; This folder is generated by publish-windows.ps1 as a self-contained win-x64 publish.
; All managed assemblies, native libraries and the .NET runtime are installed together.
Source: "..\dist\windows-x64\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Dirs]
; Legacy/local library folders expected beside the application.
Name: "{app}\netX\musiques\all"
Name: "{app}\netX\musiques\entracte"
Name: "{app}\netX\musiques\finGame"
Name: "{app}\netX\musiques\PPLocal"
Name: "{app}\netX\musiques\PPvis"
Name: "{app}\netX\musiques\buts"
Name: "{app}\netX\musiques\warmup"

; Persistent user library. Never remove imported music/preferences during uninstall/update.
Name: "{localappdata}\ArenaDJ"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques\all"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques\entracte"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques\finGame"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques\PPLocal"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques\PPvis"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques\buts"; Flags: uninsneveruninstall
Name: "{localappdata}\ArenaDJ\musiques\warmup"; Flags: uninsneveruninstall

[Icons]
Name: "{group}\Aréna DJ"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{autodesktop}\Aréna DJ"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Lancer Aréna DJ"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent
